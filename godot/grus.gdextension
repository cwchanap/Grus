[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.2"
reloadable = true

[libraries]
linux.debug.x86_64 = "res://bin/libgrus_godot.so"
linux.release.x86_64 = "res://bin/libgrus_godot.so"
macos.debug = "res://bin/libgrus_godot.dylib"
macos.release = "res://bin/libgrus_godot.dylib"
windows.debug.x86_64 = "res://bin/grus_godot.dll"
windows.release.x86_64 = "res://bin/grus_godot.dll"
